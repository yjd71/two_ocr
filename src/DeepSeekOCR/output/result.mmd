#include <iostream>
using namespace std;
const int MAX_SIZE = 5;
int st[MAX_SIZE], top = -1;

void push(int x) {
    if (top == MAX_SIZE-1)
        cout << "错误：栈已满\n";
    else 
        st[++top] = x; // 进栈：“<x endl”
}

cout << "元素数："<< top + 1 << endl;
// 空位“MAX SIZE-top-1”未使用

void pop() { }
if (top == -1)
{
    cout << "错误：栈为空\n"; // (-=-90)
}
else 
{    
    cout << "退栈:"<<st[top--]; // <-endl
}    

cout << "元素数:"<< top+1<<"endl;" //<-max size-top-1<<endl

int main()
{

push(10);
push(20);

pop();
pop();

return 0;
}